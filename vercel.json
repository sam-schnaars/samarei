{
  "rewrites": [
    { "source": "/((?!_vercel/).*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(webp|avif|png|jpe?g|gif|svg|ico|mp4|webm)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "images": {
    "sizes": [320, 640, 960, 1280, 1920],
    "formats": ["image/avif", "image/webp"],
    "minimumCacheTTL": 31536000
  }
}
